# Idea judgment: auto uses DeepSeek when a key exists, then falls back locally.
JUDGMENT_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# Speech-to-text: local is the default. Use openai only if local installation is unavailable.
STT_PROVIDER=local
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_CACHE_DIR=./cache/whisper

# Optional API transcription fallback
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional overrides
# IDEA_DB_PATH=./data/ideas.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
